# CyberSathi backend configuration
# Copy to .env and edit. Every value below has a working default —
# the application runs with NO API KEYS and NO internet connection.

# --- Security -------------------------------------------------------------
# Change this for anything beyond local development.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cybersathi-local-dev-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Database -------------------------------------------------------------
# Local SQLite file. No database server to install.
DATABASE_URL=sqlite:///./cybersathi.db

# --- CORS -----------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# --- Optional local LLM ---------------------------------------------------
# OFF by default. The assistant is fully functional without it, using the
# rule engine and TF-IDF retrieval over the knowledge base.
# To enable: install Ollama (https://ollama.com), run `ollama pull qwen2.5:3b`,
# then set ENABLE_LLM=true. Still no API key, still fully local.
ENABLE_LLM=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# --- Misc -----------------------------------------------------------------
DEBUG=true
RATE_LIMIT_PER_MINUTE=60

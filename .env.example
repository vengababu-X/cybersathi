# CyberSathi configuration template.
#
# Copy to .env:      cp .env.example .env
# Every value below has a working default. The application runs with NO API KEYS
# and NO internet connection — this file exists so you can change the few values
# that must change before a shared or public deployment.
#
# docker compose reads this file automatically. The backend reads it through
# pydantic-settings (see backend/app/config.py), where an environment variable of
# the same name always wins.

# --- Security --------------------------------------------------------------
# CHANGE THIS before any deployment that is not on your own laptop.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cybersathi-local-dev-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Database --------------------------------------------------------------
# Local SQLite file. No database server to install.
# Docker compose overrides this with sqlite:////data/cybersathi.db on a named volume.
DATABASE_URL=sqlite:///./cybersathi.db

# --- CORS ------------------------------------------------------------------
# Origins allowed to call the API. 5173 is the Vite dev server, 8080 the container.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080

# --- Optional local LLM ----------------------------------------------------
# OFF by default. The assistant is fully functional without it, using the
# rule engine and TF-IDF retrieval over the knowledge base.
# To enable: install Ollama (https://ollama.com), run `ollama pull qwen2.5:3b`,
# then set ENABLE_LLM=true. Still no API key, still fully local.
ENABLE_LLM=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# --- Misc ------------------------------------------------------------------
DEBUG=true
RATE_LIMIT_PER_MINUTE=60

# Frontend only. Leave empty in Docker (nginx proxies /api) or when vite proxies in dev.
# Set it when the API lives on a different origin, e.g. https://api.example.org
# VITE_API_BASE=
